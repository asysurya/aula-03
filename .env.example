# ─────────────────────────────────────────────────────────────
# Aula — Environment Variables
# Salin file ini menjadi .env lalu isi nilainya.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string (MongoDB Atlas / self-hosted)
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aula?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/aula?retryWrites=true&w=majority"

# Secret untuk signing session NextAuth (WAJIB diganti di production!)
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-string-acak-yang-panjang"

# URL dasar aplikasi (tanpa trailing slash)
# Lokal:  http://localhost:3000
# Deploy: https://nama-app.vercel.app (opsional di Vercel — trustHost aktif)
# PENTING: jika tidak dipakai, HAPUS baris ini — jangan diset string kosong!
NEXTAUTH_URL="http://localhost:3000"
